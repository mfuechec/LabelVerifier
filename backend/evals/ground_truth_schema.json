{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Ground truth data for LabelVerifier extraction accuracy evaluation",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this test case"
          },
          "image_path": {
            "type": "string",
            "description": "Relative path to label image from backend/"
          },
          "panel_type": {
            "type": "string",
            "enum": ["front", "back", "other"],
            "description": "Which panel of the label this image represents"
          },
          "beverage_type": {
            "type": "string",
            "enum": ["spirits", "wine", "beer"],
            "description": "Type of alcoholic beverage"
          },
          "expected_fields": {
            "type": "object",
            "description": "Expected extraction values (null if field should not be present)",
            "properties": {
              "brand_name": { "type": ["string", "null"] },
              "fanciful_name": { "type": ["string", "null"] },
              "class_type": { "type": ["string", "null"] },
              "alcohol_content": { "type": ["string", "null"] },
              "alcohol_proof": { "type": ["string", "null"] },
              "net_contents": { "type": ["string", "null"] },
              "producer_name": { "type": ["string", "null"] },
              "producer_address": { "type": ["string", "null"] },
              "country_of_origin": { "type": ["string", "null"] },
              "importer_name": { "type": ["string", "null"] },
              "importer_address": { "type": ["string", "null"] },
              "government_warning": { "type": ["string", "null"] },
              "sulfites_declaration": { "type": ["string", "null"] }
            }
          },
          "notes": {
            "type": "string",
            "description": "Optional notes about this test case (e.g., why it's tricky)"
          }
        },
        "required": ["id", "image_path", "beverage_type", "expected_fields"]
      }
    }
  },
  "required": ["version", "labels"],
  
  "_example": {
    "version": "1.0",
    "labels": [
      {
        "id": "jagermeister-front-001",
        "image_path": "test data/0. Spirits Complete/Jagermeister front.jpg",
        "panel_type": "front",
        "beverage_type": "spirits",
        "expected_fields": {
          "brand_name": "Jägermeister",
          "fanciful_name": null,
          "class_type": "Liqueur",
          "alcohol_content": "35% Alc./Vol.",
          "alcohol_proof": "70 Proof",
          "net_contents": "750mL",
          "producer_name": null,
          "producer_address": null,
          "country_of_origin": "Germany",
          "importer_name": "Sidney Frank Importing Co., Inc.",
          "importer_address": "New Rochelle, N.Y.",
          "government_warning": "GOVERNMENT WARNING: (1) According to the Surgeon General, women should not drink alcoholic beverages during pregnancy because of the risk of birth defects. (2) Consumption of alcoholic beverages impairs your ability to drive a car or operate machinery, and may cause health problems.",
          "sulfites_declaration": null
        },
        "notes": "Standard spirits label with all required fields visible"
      }
    ]
  }
}
